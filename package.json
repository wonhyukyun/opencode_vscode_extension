{
  "name": "opencode-integrated",
  "displayName": "OpenCode Integrated",
  "description": "A fully integrated OpenCode chat experience for Visual Studio Code. No separate CLI installation required.",
  "version": "0.4.3",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "opencode",
    "ai",
    "chat",
    "coding agent"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:opencodeIntegrated.rightChat",
    "onView:opencodeIntegrated.history",
    "onView:opencodeIntegrated.skills",
    "onView:opencodeIntegrated.mcp"
  ],
  "contributes": {
    "commands": [
      {
        "command": "opencodeIntegrated.open",
        "title": "OpenCode: Open Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "opencodeIntegrated.openSidebar",
        "title": "OpenCode: Open Chat in Sidebar",
        "icon": "$(layout-sidebar)"
      },
      {
        "command": "opencodeIntegrated.newChat",
        "title": "OpenCode: New Chat",
        "icon": "$(add)"
      },
      {
        "command": "opencodeIntegrated.attachSelection",
        "title": "OpenCode: Add Selection to Chat"
      },
      {
        "command": "opencodeIntegrated.showHistory",
        "title": "OpenCode: Show Chat History",
        "icon": "$(history)"
      },
      {
        "command": "opencodeIntegrated.dumpDebug",
        "title": "OpenCode: Dump Debug Log",
        "icon": "$(bug)"
      },
      {
        "command": "opencodeIntegrated.searchHistory",
        "title": "OpenCode: Search Chat History",
        "icon": "$(search)"
      },
      {
        "command": "opencodeIntegrated.refreshHistory",
        "title": "OpenCode: Refresh Chat History",
        "icon": "$(refresh)"
      },
      {
        "command": "opencodeIntegrated.loadOlderHistory",
        "title": "OpenCode: Load Older Chats",
        "icon": "$(history)"
      },
      {
        "command": "opencodeIntegrated.startHistorySelection",
        "title": "OpenCode: Select Chats",
        "icon": "$(checklist)",
        "enablement": "!opencodeIntegrated.historyDeleting"
      },
      {
        "command": "opencodeIntegrated.cancelHistorySelection",
        "title": "OpenCode: Cancel Selection",
        "icon": "$(close)",
        "enablement": "!opencodeIntegrated.historyDeleting"
      },
      {
        "command": "opencodeIntegrated.deleteSelectedHistory",
        "title": "OpenCode: Delete Selected Chats",
        "icon": "$(trash)",
        "enablement": "opencodeIntegrated.historyHasSelection && !opencodeIntegrated.historyDeleting"
      },
      {
        "command": "opencodeIntegrated.refreshSkills",
        "title": "OpenCode: Refresh Skills",
        "icon": "$(refresh)"
      },
      {
        "command": "opencodeIntegrated.refreshMcp",
        "title": "OpenCode: Refresh MCP Servers",
        "icon": "$(refresh)"
      },
      {
        "command": "opencodeIntegrated.deleteHistoryItem",
        "title": "Delete Chat",
        "icon": "$(trash)",
        "enablement": "!opencodeIntegrated.historyDeleting"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "opencodeIntegrated",
          "title": "OpenCode",
          "icon": "media/opencode.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "opencodeIntegratedChat",
          "title": "OpenCode Chat",
          "icon": "media/opencode.svg"
        }
      ]
    },
    "views": {
      "opencodeIntegrated": [
        {
          "id": "opencodeIntegrated.history",
          "name": "History"
        },
        {
          "id": "opencodeIntegrated.skills",
          "name": "Skills"
        },
        {
          "id": "opencodeIntegrated.mcp",
          "name": "MCP Servers"
        }
      ],
      "opencodeIntegratedChat": [
        {
          "type": "webview",
          "id": "opencodeIntegrated.rightChat",
          "name": "Chat"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "opencodeIntegrated.history",
        "contents": "[New chat](command:opencodeIntegrated.newChat)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "opencodeIntegrated.open",
          "when": "resourceScheme == file",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "opencodeIntegrated.newChat",
          "when": "view == opencodeIntegrated.history",
          "group": "navigation@1"
        },
        {
          "command": "opencodeIntegrated.searchHistory",
          "when": "view == opencodeIntegrated.history",
          "group": "navigation@2"
        },
        {
          "command": "opencodeIntegrated.refreshHistory",
          "when": "view == opencodeIntegrated.history",
          "group": "navigation@3"
        },
        {
          "command": "opencodeIntegrated.showHistory",
          "when": "view == opencodeIntegrated.rightChat",
          "group": "navigation@1"
        },
        {
          "command": "opencodeIntegrated.dumpDebug",
          "when": "view == opencodeIntegrated.rightChat",
          "group": "navigation@9"
        },
        {
          "command": "opencodeIntegrated.startHistorySelection",
          "when": "view == opencodeIntegrated.history && !opencodeIntegrated.historySelecting",
          "group": "navigation@4"
        },
        {
          "command": "opencodeIntegrated.deleteSelectedHistory",
          "when": "view == opencodeIntegrated.history && opencodeIntegrated.historySelecting",
          "group": "navigation@4"
        },
        {
          "command": "opencodeIntegrated.cancelHistorySelection",
          "when": "view == opencodeIntegrated.history && opencodeIntegrated.historySelecting",
          "group": "navigation@5"
        },
        {
          "command": "opencodeIntegrated.refreshSkills",
          "when": "view == opencodeIntegrated.skills",
          "group": "navigation@1"
        },
        {
          "command": "opencodeIntegrated.refreshMcp",
          "when": "view == opencodeIntegrated.mcp",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "opencodeIntegrated.deleteHistoryItem",
          "when": "view == opencodeIntegrated.history && viewItem == opencodeSession",
          "group": "inline"
        },
        {
          "command": "opencodeIntegrated.deleteHistoryItem",
          "when": "view == opencodeIntegrated.history && viewItem == opencodeSession",
          "group": "9_delete"
        }
      ],
      "commandPalette": [
        {
          "command": "opencodeIntegrated.deleteHistoryItem",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "opencodeIntegrated.attachSelection",
          "when": "editorHasSelection",
          "group": "opencode@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "opencodeIntegrated.open",
        "key": "ctrl+escape",
        "mac": "cmd+escape"
      },
      {
        "command": "opencodeIntegrated.newChat",
        "key": "ctrl+shift+escape",
        "mac": "cmd+shift+escape"
      }
    ],
    "configuration": {
      "title": "OpenCode Integrated",
      "properties": {
        "opencodeIntegrated.binaryPath": {
          "type": "string",
          "default": "",
          "description": "Optional OpenCode executable override for extension development. Leave empty to use the bundled engine."
        },
        "opencodeIntegrated.defaultModel": {
          "type": "string",
          "default": "",
          "description": "Model to preselect, in provider/model form (for example anthropic/claude-sonnet-4-5). Used when no model has been chosen yet for the selected agent. Editing this applies it right away. Leave empty to use the default OpenCode reports."
        },
        "opencodeIntegrated.harness.miniSweV2.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Register the Mini-SWE-V2 harness as the mini-swe-v2 agent: the shell is its only tool, it runs one command per step, and each command runs in a fresh process. Pick it in the agent menu or let another agent delegate to it. Takes effect after reloading the window."
        },
        "opencodeIntegrated.harness.miniSweV2.shell": {
          "type": "string",
          "enum": [
            "auto",
            "bash",
            "powershell",
            "pwsh"
          ],
          "enumDescriptions": [
            "Use the shell the engine picks (on Windows: PowerShell 7, then Windows PowerShell, then Git Bash) and write the harness prompt for it. Other agents are not affected.",
            "bash (Git Bash on Windows). Also becomes the engine's shell for every agent.",
            "Windows PowerShell 5.1. Also becomes the engine's shell for every agent.",
            "PowerShell 7+ (pwsh). Also becomes the engine's shell for every agent."
          ],
          "default": "auto",
          "markdownDescription": "Shell the `mini-swe-v2` agent runs its commands in; the harness prompt switches to that shell's syntax. The engine has one shell for all agents, so any value other than `auto` also changes the shell the other agents' bash tool uses. If the chosen shell is not installed the engine falls back to its default and the prompt follows. Takes effect after reloading the window."
        },
        "opencodeIntegrated.harness.miniSweV2.stepLimit": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Maximum steps the mini-swe-v2 agent may take per prompt. 0 means no limit. Takes effect after reloading the window."
        }
      }
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "check-types": "tsc --noEmit",
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "node scripts/test.mjs",
    "smoke": "node scripts/smoke-server.mjs",
    "prepare-binary": "node scripts/prepare-binary.mjs",
    "package": "npm run check-types && npm test && npm run prepare-binary && node esbuild.mjs --production && node scripts/package-vsix.mjs --target=win32-x64"
  },
  "dependencies": {
    "dompurify": "^3.2.6",
    "marked": "^15.0.12"
  },
  "devDependencies": {
    "@types/node": "^20.17.30",
    "@types/vscode": "^1.94.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.3",
    "parse5": "^7.3.0",
    "typescript": "^5.8.3"
  },
  "optionalDependencies": {
    "opencode-windows-x64-baseline": "1.18.32"
  }
}
